# Copy this file to .env.local and fill in real values.
# Never commit .env or .env.local — they are gitignored by default in Next.js.

# --- Site -------------------------------------------------------------------
# Used for sitemap.xml, robots.txt, canonical URLs, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=

# Postgres connection string (pooled, e.g. via PgBouncer/Prisma Accelerate)
DATABASE_URL="postgresql://user:password@host:5432/designhive?connection_limit=10&pool_timeout=20"

# Secret used to sign/verify JWTs for authenticated areas (dashboard, admin, etc.)
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# Optional: webhook fired when a new quote request comes in (Slack/CRM)
QUOTE_NOTIFY_WEBHOOK_URL=""

# --- Sanity CMS -------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# --- Cloudinary (media uploads via sanity-plugin-cloudinary) ---------------
# Cloud Name + API Key are safe client-side — Cloudinary's own security model
# means neither can perform signed/destructive operations without the secret.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=

# Server-only. Get from cloudinary.com -> Settings -> Access Keys.
# Never prefix with NEXT_PUBLIC_. Never import from a "use client" file.
CLOUDINARY_API_SECRET=

# --- Sanity write access (Orders/Messages, admin dashboard) ---------------
# Generate at manage.sanity.io -> your project -> API -> Tokens.
# "Editor" permission is sufficient. Server-only, never NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# --- Admin dashboard (/admin) ----------------------------------------------
# Single shared account for the internal team. Generate the hash with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');
#   c.scrypt(process.argv[1], s, 64, (e,k) => console.log(s+':'+k.toString('hex')));" "your-password"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
